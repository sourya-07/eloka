# Production image of the ELOKA web app (Next.js standalone output, non-root).
#
#   docker build -t eloka-client:<version> \
#     --build-arg NEXT_PUBLIC_API_BASE_URL=https://api.<root domain> client/
#
# NEXT_PUBLIC_* values are compiled into the browser bundle, so they are build arguments
# (one image per API URL). Server-side settings (ORG_META_SERVICE, ORG_META_SERVICE_SECRET,
# WLC_SUBDOMAIN_ROOT, ORG_CACHE_EXPIRY_SEC) are read at runtime from the environment.

## Stage 1: dependencies (dev dependencies are needed for the build)
FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json .npmrc ./
# --ignore-scripts: the husky "prepare" hook needs the git checkout, not the image
RUN npm ci --ignore-scripts

## Stage 2: build
FROM node:20-alpine AS builder
WORKDIR /app
ENV DOCKER_BUILD=true \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_ENV=production
# Money transactions run in the EkoConnect widget, which is off until EPS token exchange exists (ADR-0004)
ARG NEXT_PUBLIC_DISABLE_TRANSACTIONS=true
ARG NEXT_PUBLIC_CONNECT_WIDGET_URL=
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_ENV=$NEXT_PUBLIC_ENV \
    NEXT_PUBLIC_DISABLE_TRANSACTIONS=$NEXT_PUBLIC_DISABLE_TRANSACTIONS \
    NEXT_PUBLIC_CONNECT_WIDGET_URL=$NEXT_PUBLIC_CONNECT_WIDGET_URL

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN test -n "$NEXT_PUBLIC_API_BASE_URL" || (echo "Set --build-arg NEXT_PUBLIC_API_BASE_URL" && exit 1)
RUN npm run build

## Stage 3: runtime
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

# OS security fixes; npm/npx/yarn are only needed to build, so they leave the runtime image
RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /opt/yarn* /usr/local/bin/yarn* \
    && addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health >/dev/null || exit 1

# server.js is generated by `next build` with output: "standalone"
CMD ["node", "server.js"]
