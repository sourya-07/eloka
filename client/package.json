{
	"name": "eloka-webapp",
	"version": "4.41.0",
	"private": true,
	"description": "Eko's white-labelled financial platform service",
	"keywords": [
		"eko",
		"white-label"
	],
	"type": "module",
	"scripts": {
		"dev": "next dev -p 3002",
		"dev:mock": "node mock-eps/dev.js",
		"dev:server": "node scripts/dev-with-server.js",
		"mock": "node mock-eps/server.js",
		"dev.https": "next dev -p 3004 --experimental-https",
		"scan": "next dev -p 3006 & npx react-scan@latest localhost:3006",
		"inspect": "NODE_OPTIONS='--inspect' next dev",
		"build": "next build",
		"start": "next start",
		"analyze": "ANALYZE=true next build",
		"eslint": "eslint . --config eslint.config.js",
		"eslint-quiet": "eslint . --config eslint.config.js --quiet",
		"eslint-fix": "eslint . --config eslint.config.js --fix",
		"eslint-errors": "eslint . --config eslint.config.js --quiet",
		"lint": "npm run eslint",
		"lint:error": "npm run eslint-quiet",
		"lint:quiet": "npm run eslint-quiet",
		"lint-fix": "npm run eslint-fix",
		"lint-staged": "lint-staged",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"g": "plop",
		"generate": "plop",
		"prepare": "cd .. && husky client/.husky",
		"sb": "storybook dev -p 6006",
		"storybook": "storybook dev -p 6006",
		"build:storybook": "storybook build",
		"test": "jest",
		"test:mock": "node --test mock-eps/test/*.test.js",
		"test:quick": "jest --coverage=false --passWithNoTests",
		"test:failed": "jest --coverage=false --onlyFailures",
		"test:file": "jest --coverage=false --verbose",
		"test:file:pattern": "jest --coverage=false --testPathPattern",
		"test:watch": "jest --coverage=false --watch",
		"test:coverage": "jest --coverage",
		"test:update:snapshots": "jest --updateSnapshot",
		"check-deps": "node check-deps.js",
		"docker:dev": "docker compose up dev",
		"docker:prod": "docker compose up prod",
		"docker:dev:build": "docker compose up dev --build",
		"docker:prod:build": "docker compose up prod --build",
		"docker:stop": "docker compose down",
		"docker:clean": "docker compose down -v --rmi all",
		"check-updates": "npm-check -u"
	},
	"lint-staged": {
		"**/*.{js,jsx,ts,tsx}": [
			"prettier --write",
			"eslint --config eslint.config.js --fix"
		]
	},
	"overrides": {
		"eslint-config-next": {
			"eslint": "^9.4.0"
		},
		"browserslist": "^4.28.7",
		"lodash": "^4.18.0",
		"nanoid@3": "^3.3.18",
		"postcss": "$postcss",
		"serialize-javascript": "^7.0.3",
		"source-map-js": "^1.2.2"
	},
	"dependencies": {
		"@chakra-ui/icons": "^2.2.4",
		"@chakra-ui/react": "^2.10.10",
		"@copilotkit/react-core": "^1.79.0",
		"@copilotkit/react-textarea": "^1.79.0",
		"@copilotkit/react-ui": "^1.79.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@measured/puck": "^0.20.2",
		"@mediapipe/tasks-text": "^0.10.35",
		"@mediapipe/tasks-vision": "^0.10.35",
		"@next/third-parties": "^15.5.28",
		"@react-google-maps/api": "^2.20.8",
		"@react-oauth/google": "^0.13.5",
		"@types/node": "^20.19.43",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@types/react-grid-layout": "^2.1.0",
		"@xyflow/react": "^12.12.0",
		"date-fns": "^3.6.0",
		"framer-motion": "^11.18.2",
		"graphql": "^16.14.2",
		"graphql-request": "^7.4.0",
		"howler": "^2.2.4",
		"jsep": "^1.6.0",
		"jsonwebtoken": "^9.0.3",
		"kbar": "^0.1.0-beta.45",
		"lint": "^1.2.2",
		"next": "^15.5.28",
		"react": "^18.3.1",
		"react-color": "^2.19.3",
		"react-complex-tree": "^2.6.4",
		"react-dom": "^18.3.1",
		"react-grid-layout": "^2.3.0",
		"react-hook-form": "^7.90.0",
		"react-icons": "^5.7.0",
		"react-image-crop": "^11.1.2",
		"react-markdown": "^9.1.0",
		"react-player": "^2.16.1",
		"react-select": "^5.10.2",
		"react-sounds": "^1.0.30",
		"react-webcam": "^7.2.0",
		"recharts": "^3.10.1",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.0",
		"swr": "^2.5.1",
		"tinykeys": "^2.1.0",
		"uuid": "^10.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@chakra-ui/storybook-addon": "^5.2.5",
		"@chromatic-com/storybook": "^3.2.8",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/compat": "^1.4.1",
		"@next/bundle-analyzer": "^15.5.28",
		"@next/eslint-plugin-next": "^15.5.28",
		"@storybook/addon-actions": "^8.6.19",
		"@storybook/addon-essentials": "^8.6.14",
		"@storybook/addon-interactions": "^8.6.14",
		"@storybook/addon-links": "^8.6.19",
		"@storybook/addon-mdx-gfm": "^8.6.14",
		"@storybook/nextjs": "^8.6.19",
		"@storybook/react": "^8.4.7",
		"@storybook/test": "^8.4.7",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^15.0.7",
		"@testing-library/user-event": "^14.6.8",
		"@types/jest": "^29.5.12",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"autoprefixer": "^10.6.1",
		"babel-loader": "^9.2.1",
		"chromatic": "^11.29.0",
		"eslint": "^9.4.0",
		"eslint-config-next": "^15.5.28",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-jsdoc": "^48.2.6",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react-hooks": "^4.6.2",
		"eslint-plugin-storybook": "^0.12.0",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"lint-staged": "^15.5.2",
		"next-router-mock": "^0.9.13",
		"npm-check": "^6.0.1",
		"plop": "^4.0.5",
		"postcss": "^8.5.18",
		"prettier": "^3.2.5",
		"prettier-plugin-organize-imports": "^3.2.4",
		"storybook": "^8.6.19",
		"typescript": "^5.9.3"
	}
}
