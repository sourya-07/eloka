# Copy to deploy/.env and fill in. NEVER commit the real file.
# Generate keys with:  openssl rand -base64 32

# staging | production   (production refuses log-only SMS, dev keys, fixed OTP)
ELOKA_ENVIRONMENT=staging
ELOKA_VERSION=latest

# Database
MYSQL_ROOT_PASSWORD=change-me
ELOKA_DB_USERNAME=eloka
ELOKA_DB_PASSWORD=change-me

# Public setup. DNS: A records for api.<root> and *.<root> (and each custom domain) → this host.
ELOKA_PLATFORM_ROOT_DOMAIN=eloka.example.in
ELOKA_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.eloka.example.in
# Let's Encrypt account e-mail (expiry notices)
ELOKA_ACME_EMAIL=ops@example.in
# Leave empty in staging/production. "local_certs" = self-signed, for a smoke test without DNS.
ELOKA_CADDY_GLOBAL=
# How long the web app caches an org lookup (seconds)
ELOKA_ORG_CACHE_EXPIRY_SEC=300

# Eko staff review console: Google sign-in (OAuth client id of the console, Workspace domain)
ELOKA_STAFF_GOOGLE_CLIENT_ID=
ELOKA_STAFF_GOOGLE_DOMAIN=eko.co.in

# Secrets (32-byte base64 unless noted)
ELOKA_CRYPTO_FIELD_KEY=
ELOKA_CRYPTO_INDEX_KEY=
ELOKA_ORG_TOKEN_KEY=
# any long random string; also set as ORG_META_SERVICE_SECRET in the client
ELOKA_ORG_META_SECRET=
# any long random string
ELOKA_OTP_PEPPER=

# SMS: "log" only works in staging. Production needs a real provider (coming later).
ELOKA_SMS_PROVIDER=log
ELOKA_SMS_REVEAL_SECRETS=false

# Email (business-email OTP): "log" only works in staging, like SMS.
ELOKA_EMAIL_PROVIDER=log

# Uploaded documents (encrypted at rest); a volume is mounted at /app/data
ELOKA_STORAGE_PATH=/app/data/files

# Sessions (optional)
ELOKA_SESSION_IDLE_TIMEOUT=2h
ELOKA_SESSION_ABSOLUTE_TTL=12h
# Access tokens are rotated with the refresh token after this long
ELOKA_ACCESS_TOKEN_TTL=30m
