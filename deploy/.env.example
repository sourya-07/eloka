# Copy to deploy/.env and fill in. NEVER commit the real file.
# Generate keys with:  openssl rand -base64 32

# staging | production   (production refuses log-only SMS, dev keys, fixed OTP)
ELOKA_ENVIRONMENT=staging
ELOKA_VERSION=latest

# Database
MYSQL_ROOT_PASSWORD=change-me
ELOKA_DB_USERNAME=eloka
ELOKA_DB_PASSWORD=change-me

# Public setup
ELOKA_PLATFORM_ROOT_DOMAIN=eloka.example.in
ELOKA_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.eloka.example.in

# Secrets (32-byte base64 unless noted)
ELOKA_CRYPTO_FIELD_KEY=
ELOKA_CRYPTO_INDEX_KEY=
ELOKA_ORG_TOKEN_KEY=
# any long random string; also set as ORG_META_SERVICE_SECRET in the client
ELOKA_ORG_META_SECRET=
# any long random string
ELOKA_OTP_PEPPER=

# SMS: "log" only works in staging. Production needs a real provider (coming later).
ELOKA_SMS_PROVIDER=log
ELOKA_SMS_REVEAL_SECRETS=false

# Sessions (optional)
ELOKA_SESSION_IDLE_TIMEOUT=2h
ELOKA_SESSION_ABSOLUTE_TTL=12h
