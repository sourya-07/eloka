# TLS edge for the ELOKA stack (Caddy 2). Certificates are automatic (Let's Encrypt).
#   https://api.<root>      → server:8080 (EPS-compatible API + /v1)
#   https://<anything else> → client:3000 (tenant sites: <label>.<root> and custom domains)
# Tenant certificates are issued on demand, only for hostnames the server confirms
# (GET /v1/system/tls-allowed), so the edge cannot be abused to request random certificates.
{
	email {$ELOKA_ACME_EMAIL}
	on_demand_tls {
		ask http://server:8080/v1/system/tls-allowed
	}
	# Set ELOKA_CADDY_GLOBAL=local_certs for a smoke test without public DNS (self-signed).
	{$ELOKA_CADDY_GLOBAL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	log {
		output stdout
		format json
	}
}

api.{$ELOKA_PLATFORM_ROOT_DOMAIN} {
	import common
	# The applicant/staff APIs and the EPS calls; uploads up to 10 MB
	request_body {
		max_size 10MB
	}
	reverse_proxy server:8080
}

https:// {
	import common
	tls {
		on_demand
	}
	reverse_proxy client:3000
}
